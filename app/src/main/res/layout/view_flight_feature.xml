<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView android:id="@+id/camera_preview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/photo_capture_feedback"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:background="#26FFFFFF" android:clickable="false"
        android:focusable="false" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:background="@drawable/cockpit_panel"
            android:drawablePadding="8dp" android:gravity="center" android:minWidth="118dp"
            android:paddingHorizontal="16dp" android:paddingVertical="10dp"
            android:text="@string/captured_indicator" android:textColor="#FFFFFFFF" android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
    <TextView
        android:id="@+id/preview_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/cockpit_panel"
        android:clickable="false"
        android:gravity="center"
        android:maxWidth="320dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:text="@string/waiting_video"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <Button
        android:id="@+id/video_power_saving"
        android:layout_width="96dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="66dp"
        android:background="@drawable/cockpit_button"
        android:minHeight="0dp"
        android:text="@string/video_power_saving_on"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <FrameLayout android:id="@+id/map_pane" android:layout_width="170dp" android:layout_height="96dp" android:layout_gravity="bottom|start" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:background="@drawable/cockpit_panel_strong" android:clipToOutline="true">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFE8EDF1" />
        <ViewStub
            android:id="@+id/map_widget_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inflatedId="@+id/map_widget"
            android:layout="@layout/view_lazy_map_widget" />
        <TextView android:id="@+id/map_location_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="#CC17212C" android:gravity="center" android:maxWidth="150dp" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:text="@string/map_waiting_for_location" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        <TextView android:id="@+id/map_toggle" android:layout_width="42dp" android:layout_height="28dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:background="@drawable/map_overlay_button" android:elevation="4dp" android:gravity="center" android:text="@string/action_fullscreen_compact" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        <TextView android:id="@+id/survey_open" android:layout_width="46dp" android:layout_height="28dp" android:layout_gravity="top|center_horizontal" android:layout_margin="4dp" android:background="@drawable/map_overlay_button" android:elevation="4dp" android:gravity="center" android:text="@string/feature_survey" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        <TextView android:id="@+id/map_layer" android:layout_width="42dp" android:layout_height="28dp" android:layout_gravity="top|start" android:layout_margin="4dp" android:background="@drawable/map_overlay_button" android:elevation="4dp" android:gravity="center" android:text="@string/map_satellite_compact" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_direction" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="bottom|start" android:layout_margin="4dp" android:background="@drawable/cockpit_panel" android:gravity="center" android:paddingHorizontal="5dp" android:text="H --" android:textColor="#FFF29A2E" android:textSize="8sp" android:visibility="gone" />
        <TextView android:id="@+id/survey_eta" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="bottom|end" android:layout_margin="4dp" android:background="@drawable/cockpit_panel" android:gravity="center" android:paddingHorizontal="5dp" android:textColor="#FFB8FFE8" android:textSize="8sp" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|start" android:layout_marginStart="18dp" android:gravity="center_horizontal" android:orientation="vertical">
        <Button android:id="@+id/takeoff" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/cockpit_takeoff" android:contentDescription="@string/action_hold_to_take_off" android:gravity="center" android:text="↑" android:textAllCaps="false" android:textColor="#AFFFFFFF" android:textSize="24sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/action_hold_to_take_off" android:textColor="#B8FFFFFF" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/safety_panel" android:layout_width="430dp" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="66dp" android:background="@drawable/cockpit_panel_strong" android:elevation="3dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="2dp" android:background="@drawable/bg_dot_amber" />
            <TextView android:id="@+id/safety_status" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="start|center_vertical" android:paddingHorizontal="8dp" android:text="@string/emergency_disconnected_owner_none" android:textColor="@color/of_hud_text_primary" android:textSize="11sp" android:textStyle="bold" />
            <Button android:id="@+id/safety_minimize" android:layout_width="34dp" android:layout_height="32dp" android:background="@drawable/cockpit_button" android:minHeight="0dp" android:text="−" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/safety_controls" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:orientation="horizontal">
            <Button android:id="@+id/return_home" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/cockpit_button" android:text="@string/survey_completion_rth" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
            <Button android:id="@+id/cancel_return_home" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/cockpit_button" android:text="@string/action_cancel_return_home" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
            <Button android:id="@+id/land" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/cockpit_button" android:text="@string/action_land" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
            <Button android:id="@+id/cancel_landing" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/cockpit_button" android:text="@string/action_cancel_landing" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
            <Button android:id="@+id/confirm_landing" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/cockpit_button_danger" android:text="@string/action_confirm_landing" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="10sp" android:visibility="gone" />
            <Button android:id="@+id/device_qualification" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/instrument_panel"
        android:layout_width="278dp"
        android:layout_height="99dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="186dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ViewStub
            android:id="@+id/hsi_widget_stub"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:inflatedId="@+id/hsi_widget"
            android:layout="@layout/view_lazy_hsi_widget" />

        <TextView
            android:id="@+id/lite_instruments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cockpit_panel"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="ALT --   SPD --\nHDG --   VS --"
            android:textColor="#FFC9D4DF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView android:id="@+id/telemetry" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/export_flight_log" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/camera_rail_host" android:layout_width="64dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="10dp" android:clickable="true" android:importantForAccessibility="no" />
</FrameLayout>
