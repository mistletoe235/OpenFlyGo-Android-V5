<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3478C6" />
            <stroke android:width="1dp" android:color="#FF2768B2" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF3F5F7" />
            <stroke android:width="1dp" android:color="#FFD8DDE3" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
